{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!next-env.d.ts", "!public", "!tsconfig.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
      "cssModules": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "all",
      "react": "all"
    },
    "rules": {
      "preset": "all",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noReactNativeRawText": "off",
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off",
        "usePlaywrightValidDescribeCallback": "off",
        "noNodejsModules": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noEmptyBlockStatements": "error",
        "useAwait": "error",
        "noUnknownAttribute": "off",
        "useBaseline": {
          "level": "error",
          "options": {
            "allowProperties": ["transform-box", "mask-image"],
            "allowSelectors": ["selection"]
          }
        },
        "noReactSpecificProps": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "noInferrableTypes": "error",
        "useAsConstAssertion": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConst": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "noReactNativeLiteralColors": "off",
        "noDefaultExport": "off",
        "useComponentExportOnlyModules": "off",
        "noTernary": "off",
        "noNestedTernary": "off",
        "noJsxLiterals": "off",
        "noInlineStyles": "off",
        "noMagicNumbers": "off",
        "noContinue": "off",
        "useExportsLast": "off",
        "noProcessEnv": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "snake_case"]
              }
            ]
          }
        }
      },
      "complexity": {
        "noUselessFragments": "error",
        "noUselessStringConcat": "error",
        "useOptionalChain": "error",
        "useSimplifiedLogicExpression": "error",
        "noExcessiveLinesPerFunction": "off"
      },
      "performance": {
        "useSolidForComponent": "off",
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["components/ui/**"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": ["app/**/page.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "useUniqueElementIds": "off"
          }
        }
      }
    },
    {
      "includes": ["types/**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off",
            "useConsistentTypeDefinitions": "off",
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
